# Google Apps Script web app URL that appends registrations to the Sheet.
# See docs/google-sheet-setup.md. Server-only.
GOOGLE_SHEET_WEBHOOK_URL=

# Optional shared secret, must match the SECRET script property in Apps Script. Server-only.
GOOGLE_SHEET_WEBHOOK_SECRET=

# WhatsApp invite link for The Vertex community. Teachers are redirected here after registering.
NEXT_PUBLIC_VERTEX_WHATSAPP_URL=
